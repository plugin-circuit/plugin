# Script mode: cmake -DOUTPUT=... -DROOT=... -DFILES=a|b|c -P embed_resources_run.cmake
string(REPLACE "|" ";" FILES "${FILES}")

set(body "")
set(table "")
set(i 0)
foreach(f IN LISTS FILES)
	file(RELATIVE_PATH rel ${ROOT} ${f})
	get_filename_component(ext ${f} LAST_EXT)
	string(TOLOWER "${ext}" ext)
	set(mime "application/octet-stream")
	if (ext STREQUAL ".html")
		set(mime "text/html")
	elseif (ext STREQUAL ".js" OR ext STREQUAL ".mjs")
		set(mime "text/javascript")
	elseif (ext STREQUAL ".css")
		set(mime "text/css")
	elseif (ext STREQUAL ".svg")
		set(mime "image/svg+xml")
	elseif (ext STREQUAL ".json")
		set(mime "application/json")
	elseif (ext STREQUAL ".png")
		set(mime "image/png")
	elseif (ext STREQUAL ".woff2")
		set(mime "font/woff2")
	endif()
	file(READ ${f} hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR size "${hexlen} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(APPEND body "static const unsigned char r${i}[] = {${bytes} 0};\n")
	string(APPEND table "\t{\"/${rel}\", r${i}, ${size}, \"${mime}\"},\n")
	math(EXPR i "${i} + 1")
endforeach()

file(WRITE ${OUTPUT}.tmp "// generated by embed_resources_run.cmake, do not edit
#include <cstddef>
#include <cstring>
#include <string_view>
namespace plugincircuit::resources {
struct Resource { const char *path; const unsigned char *data; size_t size; const char *mime; };
${body}
static const Resource table[] = {
${table}\t{nullptr, nullptr, 0, nullptr}
};
const Resource * find(std::string_view path) {
	for (auto *r = table; r->path; ++r) if (path == r->path) return r;
	return nullptr;
}
}
")
file(COPY_FILE ${OUTPUT}.tmp ${OUTPUT} ONLY_IF_DIFFERENT)
file(REMOVE ${OUTPUT}.tmp)
