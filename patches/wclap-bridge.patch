+	// WCLAP_WASMTIME_TARGET=pulley64 runs WCLAPs on Wasmtime's portable interpreter (no executable memory:
+	// what an iOS device needs). Default: the native Cranelift backend.
+	if (const char *target = std::getenv("WCLAP_WASMTIME_TARGET"); target && *target) {
+		if (auto *targetError = wasmtime_config_target_set(config, target)) {
+			logError(targetError);
+			wasmtime_error_delete(targetError);
+		}
+	}
+
+	// WCLAP_WASMTIME_OPT=none|speed|speed_and_size: Cranelift optimisation level (default speed)
+	if (const char *opt = std::getenv("WCLAP_WASMTIME_OPT"); opt && *opt) {
+		std::string o = opt;
+		wasmtime_config_cranelift_opt_level_set(config, o == "none" ? WASMTIME_OPT_LEVEL_NONE
